# Gmail OAuth — paths to credential and token files
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# SQLite location
PULSE_DB_FILE=pulse.db

# Gmail filtering
PULSE_GMAIL_LABEL=Pulse
PULSE_GMAIL_ALLOWED_DOMAINS=nytimes.com,wsj.com
PULSE_GMAIL_MAX_RESULTS=200

# Primary LLM: Anthropic (Claude) — best quality
ANTHROPIC_API_KEY=
PULSE_SUMMARY_MODEL=claude-haiku-4-5-20251001
PULSE_ANALYSIS_MODEL=claude-sonnet-4-6

# Fallback: Groq (free, fast, small context) — console.groq.com
GROQ_API_KEY=
PULSE_GROQ_MODEL=llama-3.1-8b-instant

# Fallback: OpenAI
OPENAI_API_KEY=
PULSE_OPENAI_MODEL=gpt-4o-mini

# Per-sync cap on number of newsletters that get LLM summaries
# (overflow falls back to heuristic — set higher than your daily newsletter volume)
PULSE_MODEL_SUMMARY_BUDGET=60

# === Cloud deploy only ===
# Base64-encoded credentials.json and token.json — used by main.py bootstrap to
# write the files to disk on cold start. Get via: base64 -w 0 credentials.json
# GMAIL_CREDENTIALS_B64=
# GMAIL_TOKEN_B64=
